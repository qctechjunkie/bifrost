# ==============================================================================
# Bifrost Docker Compose — Environment Variables
# Copy this file to .env and fill in your values.
# ==============================================================================

# Path where persistent data is stored on the host.
# All service data will be written under subdirectories here.
# Example: DOCKER_DATA_PATH=/mnt/data
DOCKER_DATA_PATH=/mnt/data

# ---- Bifrost -----------------------------------------------------------------

# Port exposed on the host for the Bifrost Web UI and API
BIFROST_PORT=8080

# Log verbosity: debug | info | warn | error
LOG_LEVEL=info

# Log format: json | pretty
LOG_STYLE=json

# ---- PostgreSQL (Global Instance) -------------------------------------------

# Container name of the global-postgres instance on this host
POSTGRES_HOST=lxc103-postgres

# Docker network shared with global-postgres (must match NETWORK_NAME in global-postgres .env)
POSTGRES_NETWORK_NAME=lxc103-postgres-network

# Bifrost database user credentials (must match global-postgres .env)
POSTGRES_USER=bifrost
POSTGRES_PASSWORD=changeme

# Database names (must match global-postgres .env)
POSTGRES_CONFIG_DB=bifrost_config
POSTGRES_LOGS_DB=bifrost_logs
