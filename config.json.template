{
  "client": {
    "drop_excess_requests": false
  },
  "config_store": {
    "enabled": true,
    "type": "postgres",
    "config": {
      "host": "env.POSTGRES_HOST",
      "port": "env.POSTGRES_PORT",
      "user": "env.POSTGRES_USER",
      "password": "env.POSTGRES_PASSWORD",
      "db_name": "env.POSTGRES_CONFIG_DB",
      "ssl_mode": "env.POSTGRES_SSLMODE",
      "max_idle_conns": 5,
      "max_open_conns": 50
    }
  },
  "logs_store": {
    "enabled": true,
    "type": "postgres",
    "retention_days": 30,
    "config": {
      "host": "env.POSTGRES_HOST",
      "port": "env.POSTGRES_PORT",
      "user": "env.POSTGRES_USER",
      "password": "env.POSTGRES_PASSWORD",
      "db_name": "env.POSTGRES_LOGS_DB",
      "ssl_mode": "env.POSTGRES_SSLMODE",
      "max_idle_conns": 5,
      "max_open_conns": 50
    }
  }
}
